<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>5.0.0</Version>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>TreytNpap.Yarp.ReverseProxy.Swagger</PackageId>
        <Authors>Andrei Tsaregorodtsev, Nick Papadiochos</Authors>
        <PackageProjectUrl>https://github.com/npapadiochos/yarp-swagger</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="IdentityModel.AspNetCore" Version="4.3.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
        <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.28" />
        <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    </ItemGroup>

</Project>
